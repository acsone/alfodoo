<odoo>

    <record model="ir.ui.view" id="cmis_backend_form_view">
        <field name="name">cmis.backend.form (in cmis_web_proxy)</field>
        <field name="model">cmis.backend</field>
        <field name="inherit_id" ref="cmis.cmis_backend_form_view" />
        <field name="arch" type="xml">
            <group name="cmis_right" position="after">
                <group name="cmis_proxy_left">
                    <field name="is_cmis_proxy"/>
                </group>
                <group name="cmis_proxy_right">
                    <field name="apply_odoo_security" attrs="{'invisible': [('is_cmis_proxy', '=', False)]}"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
